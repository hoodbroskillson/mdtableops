    "agents",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoodbroskillson/mdtableops.git"
  },
  "bugs": {
    "url": "https://github.com/hoodbroskillson/mdtableops/issues"
  },
  "homepage": "https://github.com/hoodbroskillson/mdtableops#readme",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@vitest/coverage-v8": "^2.1.0",
    "typescript": "^7.0.2",
    "vitest": "^2.1.0"
  },
  "exports": {
    ".": {
